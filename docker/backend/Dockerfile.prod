# syntax=docker/dockerfile:1
# Airlink v3.0 backend — production image (php-fpm, no dev deps, code baked in).
# Build context is the repo root: docker build -f docker/backend/Dockerfile.prod .
FROM php:8.3-fpm-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
        git unzip libzip-dev libpng-dev libjpeg62-turbo-dev libfreetype6-dev libicu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j"$(nproc)" pdo_mysql bcmath gd zip intl pcntl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1
ENV COMPOSER_CACHE_DIR=/composer-cache
WORKDIR /var/www/html

# Shared GID with the host's `radiusweb` group, so www-data can write the
# bind-mounted clients.conf / restart-trigger without any other host access.
RUN groupadd -g 5555 radiusweb && usermod -aG radiusweb www-data

# App code + production dependencies.
#
# - The cache mount persists downloaded packages across builds (and across
#   `docker compose build` for app/queue/scheduler, which all share this same
#   Dockerfile+context) so a retry only re-fetches what actually failed last
#   time, instead of hitting GitHub for all ~100 packages every attempt.
# - The github_token secret is optional (BuildKit leaves it unmounted if not
#   passed via `--secret id=github_token,...`). When present, it switches
#   Composer's GitHub downloads from the low-ceiling anonymous path to the
#   authenticated API, which is what actually fixes sustained 429/504s from
#   codeload.github.com — a token needs no scopes, it just needs to exist.
COPY backend/ /var/www/html/
RUN --mount=type=cache,target=/composer-cache,sharing=locked \
    --mount=type=secret,id=github_token \
    if [ -s /run/secrets/github_token ]; then \
        composer config -g github-oauth.github.com "$(cat /run/secrets/github_token)"; \
    fi \
    && composer install --no-dev --optimize-autoloader --no-interaction --no-progress \
    && chown -R www-data:www-data storage bootstrap/cache

COPY docker/backend/prod-entrypoint.sh /usr/local/bin/prod-entrypoint.sh
RUN chmod +x /usr/local/bin/prod-entrypoint.sh

EXPOSE 9000
ENTRYPOINT ["prod-entrypoint.sh"]
CMD ["php-fpm"]
